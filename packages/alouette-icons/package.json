{
  "name": "alouette-icons",
  "version": "12.0.0",
  "description": "icons for alouette",
  "keywords": [],
  "homepage": "https://github.com/christophehurpeau/alouette",
  "bugs": {
    "url": "https://github.com/christophehurpeau/alouette/issues"
  },
  "license": "UNLICENSED",
  "author": "Christophe Hurpeau <302891+christophehurpeau@users.noreply.github.com> (https://christophe.hurpeau.com)",
  "repository": {
    "type": "git",
    "url": "https://github.com/christophehurpeau/alouette.git",
    "directory": "packages/alouette-icons"
  },
  "files": [
    "lib"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    "./package.json": "./package.json",
    "./createIcon": {
      "types": "./lib/createIcon.d.ts",
      "react-native": {
        "import": "./lib/createIcon.react-native.mjs"
      },
      "browser": "./lib/createIcon.web.mjs",
      "web": "./lib/createIcon.web.mjs",
      "node": {
        "web": {
          "import": "./lib/createIcon.web.mjs"
        },
        "react-native": {
          "import": "./lib/createIcon.react-native.mjs"
        },
        "import": "./lib/createIcon.web.mjs"
      },
      "import": "./lib/createIcon.web.mjs"
    },
    "./phosphor-icons/*": {
      "types": "./lib/phosphor-icons/*.d.ts",
      "import": "./lib/phosphor-icons/*.mjs"
    }
  },
  "scripts": {
    "build": "pnpm run build:definitions",
    "build:definitions": "tsc -p tsconfig.json",
    "lint": "pnpm run lint:oxlint && pnpm run lint:eslint",
    "lint:eslint": "pnpm --dir '../..' exec eslint --quiet 'packages/alouette-icons'",
    "lint:oxlint": "pnpm --dir '../..' exec oxlint --quiet 'packages/alouette-icons'",
    "test": "yarn '../..' run test -- packages/alouette-icons",
    "tsc": "tsc"
  },
  "devDependencies": {
    "@phosphor-icons/core": "2.1.1",
    "@typescript/native": "npm:typescript@7.0.2",
    "react-native": "0.86.2",
    "typescript": "npm:@typescript/typescript6@6.0.2"
  },
  "peerDependencies": {
    "react": "^19.2.3",
    "react-native": "*",
    "react-native-svg": "*"
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "pob": {
    "entries": [
      "phosphor-icons"
    ],
    "typescript": "check-only"
  }
}
