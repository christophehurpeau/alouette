{
  "name": "storybook-native-app",
  "version": "14.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "main": "src/AppEntry",
  "scripts": {
    "build-storybook": "storybook build",
    "chromatic": "npx chromatic",
    "lint": "yarn run lint:eslint",
    "lint:eslint": "yarn '../..' eslint --quiet packages/storybook-app",
    "screenshots:check": "pnpm run build-storybook && playwright test",
    "screenshots:update": "pnpm run build-storybook && rm -rf snapshots && playwright install chromium && playwright test --update-snapshots",
    "serve:build": "pnpm dlx http-server -p 6006 storybook-static",
    "start": "expo start",
    "start:android": "expo start --android",
    "start:ios": "expo start --ios",
    "start:web": "storybook dev -p 6006",
    "test": "vitest --project=storybook",
    "test:prepare": "playwright install chromium"
  },
  "dependencies": {
    "@babel/core": "7.29.7",
    "@expo-google-fonts/chivo-mono": "0.4.2",
    "@expo-google-fonts/sora": "0.4.2",
    "@expo/metro-config": "57.0.8",
    "@gorhom/bottom-sheet": "5.2.14",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/datetimepicker": "9.1.0",
    "@react-native-community/slider": "5.2.0",
    "@react-native/metro-config": "0.86.2",
    "alouette": "workspace:*",
    "alouette-icons": "workspace:*",
    "expo": "57.0.12",
    "expo-constants": "57.0.14",
    "expo-status-bar": "57.0.1",
    "lightningcss": "1.30.1",
    "nativewind": "5.0.0-rc.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.2",
    "react-native-css": "3.1.0-rc.0",
    "react-native-gesture-handler": "2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "5.8.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "0.21.2",
    "react-native-worklets": "0.10.1",
    "tailwindcss": "4.3.3"
  },
  "devDependencies": {
    "@babel/preset-env": "7.29.7",
    "@playwright/test": "1.62.1",
    "@storybook/addon-docs": "10.6.1",
    "@storybook/addon-ondevice-actions": "10.6.0",
    "@storybook/addon-ondevice-backgrounds": "10.6.0",
    "@storybook/addon-ondevice-controls": "10.6.0",
    "@storybook/addon-ondevice-notes": "10.6.0",
    "@storybook/addon-vitest": "10.6.1",
    "@storybook/react": "10.6.1",
    "@storybook/react-native": "10.6.0",
    "@storybook/react-native-web-vite": "10.6.1",
    "@storybook/react-vite": "10.6.1",
    "@tailwindcss/postcss": "4.3.3",
    "@tailwindcss/vite": "4.3.3",
    "@types/react": "19.2.17",
    "@vitejs/plugin-react": "6.0.2",
    "@vitest/browser-playwright": "4.1.11",
    "chromatic": "17.4.0",
    "expo-svg-transformer": "3.2.0",
    "playwright": "1.62.1",
    "storybook": "10.6.1",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "vite": "8.3.0",
    "vite-plugin-rnw": "0.0.12",
    "vite-plugin-svgr": "4.5.0",
    "vitest": "4.1.11"
  },
  "expo": {
    "install": {
      "exclude": [
        "typescript"
      ]
    }
  }
}
