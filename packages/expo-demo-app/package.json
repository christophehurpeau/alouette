{
  "name": "expo-demo-app",
  "version": "4.0.1",
  "private": true,
  "homepage": "https://github.com/christophehurpeau/alouette",
  "license": "MIT",
  "author": "Christophe Hurpeau <302891+christophehurpeau@users.noreply.github.com> (https://christophe.hurpeau.com)",
  "repository": {
    "type": "git",
    "url": "https://github.com/christophehurpeau/alouette.git",
    "directory": "packages/expo-demo-app"
  },
  "type": "module",
  "main": "./src/AppEntry.tsx",
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "lint": "pnpm run lint:oxlint && pnpm run lint:eslint",
    "lint:eslint": "pnpm --dir '../..' exec eslint --quiet 'packages/expo-demo-app'",
    "lint:oxlint": "pnpm --dir '../..' exec oxlint --quiet 'packages/expo-demo-app'",
    "start": "expo start",
    "start:android": "expo start --android",
    "start:ios": "expo start --ios",
    "start:web": "expo start --web",
    "tsc": "tsrs",
    "tsc:go": "tsc",
    "upgrade-expo": "expo install expo@58 --fix"
  },
  "dependencies": {
    "@babel/core": "7.29.7",
    "@expo-google-fonts/chivo-mono": "0.4.2",
    "@expo-google-fonts/sora": "0.4.2",
    "@expo/log-box": "58.0.14",
    "@expo/metro-config": "58.0.20",
    "@expo/metro-runtime": "58.0.16",
    "@react-native/metro-config": "0.88.1",
    "alouette": "workspace:*",
    "alouette-icons": "workspace:*",
    "expo": "58.0.22",
    "expo-constants": "58.0.14",
    "expo-linking": "58.0.15",
    "expo-router": "58.0.29",
    "expo-status-bar": "58.0.4",
    "lightningcss": "1.30.1",
    "nativewind": "5.0.0-rc.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-css": "3.1.0-rc.0",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "5.10.1",
    "react-native-screens": "4.30.1",
    "react-native-svg": "15.16.0",
    "react-native-web": "0.21.4",
    "react-native-worklets": "0.13.0",
    "tailwindcss": "4.3.4"
  },
  "devDependencies": {
    "@babel/preset-env": "7.29.7",
    "@tailwindcss/postcss": "4.3.4",
    "@types/react": "19.3.0",
    "@typescript/native": "npm:typescript@7.0.2",
    "tsrs": "0.18.0-ts7.1.0-dev.20260929",
    "typescript": "npm:@typescript/typescript6@6.0.2"
  },
  "engines": {
    "node": "^22.18.0 || >=24.14.1"
  },
  "expo": {
    "install": {
      "exclude": [
        "typescript"
      ]
    }
  }
}
