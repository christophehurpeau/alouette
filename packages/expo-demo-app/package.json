{
  "name": "expo-demo-app",
  "version": "1.1.0",
  "private": true,
  "homepage": "https://github.com/christophehurpeau/alouette",
  "license": "MIT",
  "author": "Christophe Hurpeau <302891+christophehurpeau@users.noreply.github.com> (https://christophe.hurpeau.com)",
  "repository": {
    "type": "git",
    "url": "https://github.com/christophehurpeau/alouette.git",
    "directory": "packages/expo-demo-app"
  },
  "type": "module",
  "main": "./src/AppEntry.tsx",
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "lint": "pnpm run lint:eslint",
    "lint:eslint": "pnpm run --dir '../..' eslint --quiet 'packages/expo-demo-app'",
    "start": "expo start",
    "start:android": "expo start --android",
    "start:ios": "expo start --ios",
    "start:web": "expo start --web",
    "tsc": "tsc",
    "upgrade-expo": "expo install expo@57 --fix"
  },
  "dependencies": {
    "@babel/core": "7.29.7",
    "@expo-google-fonts/chivo-mono": "0.4.2",
    "@expo-google-fonts/sora": "0.4.2",
    "@expo/log-box": "57.0.3",
    "@expo/metro-config": "57.0.8",
    "@expo/metro-runtime": "57.0.13",
    "@react-native/metro-config": "0.86.0",
    "alouette": "workspace:*",
    "alouette-icons": "workspace:*",
    "expo": "57.0.12",
    "expo-constants": "57.0.14",
    "expo-linking": "57.0.7",
    "expo-router": "57.0.16",
    "expo-status-bar": "57.0.1",
    "lightningcss": "1.30.1",
    "nativewind": "5.0.0-preview.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-native": "0.86.2",
    "react-native-css": "3.0.7",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "5.8.0",
    "react-native-screens": "4.27.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "0.21.2",
    "react-native-worklets": "0.10.1",
    "tailwindcss": "4.3.3"
  },
  "devDependencies": {
    "@babel/preset-env": "7.29.7",
    "@tailwindcss/postcss": "4.3.3",
    "@types/react": "19.2.18",
    "@typescript/native": "npm:typescript@7.0.2",
    "typescript": "npm:@typescript/typescript6@6.0.2"
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "expo": {
    "install": {
      "exclude": [
        "typescript"
      ]
    }
  }
}
