{
  "name": "alouette-monorepo",
  "private": true,
  "description": "Alouette is a modern, customizable design system built on top of NativeWind v5. It provides a comprehensive set of components and tools to build consistent, accessible, and performant user interfaces for React and React Native applications.",
  "homepage": "https://github.com/christophehurpeau/alouette",
  "bugs": {
    "url": "https://github.com/christophehurpeau/alouette/issues"
  },
  "license": "ISC",
  "author": "Christophe Hurpeau <christophe@hurpeau.com> (https://christophe.hurpeau.com)",
  "repository": "https://github.com/christophehurpeau/alouette.git",
  "workspaces": [
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "build": "pnpm run clean:build && rollup --config rollup.config.mjs && pnpm run build:definitions",
    "build:definitions": "tsc -b",
    "clean:build": "pnpm -r --parallel run clean:build",
    "format": "oxfmt",
    "format:check": "oxfmt --check .",
    "lint": "pnpm run format && pnpm run lint:eslint",
    "lint:eslint": "eslint --quiet .",
    "prepare": "pob-root-postinstall",
    "storybook": "yarn ./packages/storybook-app start",
    "test": "TZ=UTC vitest",
    "test:coverage": "TZ=UTC POB_VITEST_COVERAGE=json,text vitest run --coverage",
    "test:coverage:generate": "TZ=UTC POB_VITEST_COVERAGE=json vitest run --coverage",
    "test:watch": "TZ=UTC vitest --watch",
    "tsc": "tsc -b",
    "watch": "pnpm run clean:build && rollup --config rollup.config.mjs --watch"
  },
  "devDependencies": {
    "@pob/eslint-config": "67.3.0",
    "@pob/eslint-config-typescript-react": "67.3.0",
    "@pob/rollup-esbuild": "10.0.0",
    "@pob/root": "27.4.0",
    "@testing-library/dom": "10.4.1",
    "@testing-library/react": "16.3.2",
    "@typescript/native": "npm:typescript@7.0.2",
    "@vitest/coverage-v8": "4.1.10",
    "color-convert": "3.1.3",
    "eslint": "10.8.0",
    "eslint-plugin-storybook": "10.4.6",
    "happy-dom": "20.11.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "storybook": "10.5.7",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "vite": "8.1.5",
    "vitest": "4.1.10"
  },
  "resolutions": {
    "lightningcss": "1.30.1"
  },
  "commitlint": {
    "extends": [
      "@pob/root/commitlint-config"
    ]
  },
  "engines": {
    "node": ">=22.18.0",
    "pnpm": ">= 11.0.0"
  },
  "resolutionsExplained": {
    "lightningcss": "react-native-css 3.0.7 breaks at runtime with lightningcss >=1.31 (visitor AST 'failed to deserialize Specifier'); pin its copy to 1.30.x while vite requires ^1.32.0"
  }
}
